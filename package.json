{
  "name": "login-kitsic",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "npm run generate --workspace=@kitsic/database",
    "db:migrate": "npm run migrate --workspace=@kitsic/database",
    "db:migrate:core": "npm run migrate:core --workspace=@kitsic/database",
    "db:migrate:boards": "npm run migrate:boards --workspace=@kitsic/database",
    "db:migrate:platform": "npm run migrate:platform --workspace=@kitsic/database",
    "db:migrate:storage": "npm run migrate:storage --workspace=@kitsic/database",
    "db:migrate:member-ids": "npm run migrate:member-ids --workspace=@kitsic/database",
    "db:migrate:signup-fix": "npm run migrate:signup-fix --workspace=@kitsic/database",
    "db:migrate:task-comments": "npm run migrate:task-comments --workspace=@kitsic/database",
    "db:migrate:google-meet": "npm run migrate:google-meet --workspace=@kitsic/database",
    "db:migrate:meeting-mom": "npm run migrate:meeting-mom --workspace=@kitsic/database",
    "db:migrate:leadership-roles": "npm run migrate:leadership-roles --workspace=@kitsic/database",
    "db:seed": "npm run seed --workspace=@kitsic/database",
    "db:seed:demo": "npm run seed:demo --workspace=@kitsic/database",
    "db:cleanup:demo": "npm run cleanup:demo --workspace=@kitsic/database",
    "db:create:president": "npm run create:president --workspace=@kitsic/database",
    "db:seed:modules": "npm run seed:modules --workspace=@kitsic/database",
    "db:seed:extended": "npm run seed:extended --workspace=@kitsic/database"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.7.0"
}
